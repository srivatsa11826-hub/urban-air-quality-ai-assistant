# ============ SERVER CONFIGURATION ============
PORT=3000
NODE_ENV=development

# ============ SECURITY ============
# Secret key used for signing and verifying JWT tokens (required in production)
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============ DATABASE ============
# Path to SQLite database file (defaults to ./airguard.db; uses :memory: during tests)
DB_PATH=./airguard.db

# ============ AI & AQI TELEMETRY ============
# Google Gemini API Key for air quality health consultation and content generation
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini model name (default: gemini-2.5-flash, with automatic fallback cascade)
GEMINI_MODEL=gemini-2.5-flash

# World Air Quality Index (WAQI) API token (optional; automatic simulation fallback is provided)
# Free token at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_token_here
