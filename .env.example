# ============ SERVER ============
PORT=3000
NODE_ENV=development

# ============ SECURITY ============
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============ DATABASE ============
DB_PATH=./airguard.db

# ============ AI & AQI APIs ============
# Gemini API key (users can also provide their own)
GEMINI_API_KEY=your_gemini_api_key_here

# WAQI (World Air Quality Index) - free at https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_token_here

# Open-Meteo is free and needs no key (used for weather)
